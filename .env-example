# Local Bash configuration (never committed as .env). Paths may use $HOME.
# First use: sandwich integrations configure
# Override the file location with SANDWICH_ENV_FILE=/path/to/.env.
HERMES_PROJECTS_DIR="$HOME/Hermes"
HERMES_LIVE_DIR="$HOME/.hermes/hermes-agent"

# Add any number of PROJECT_N blocks, with distinct positive integers.
# Run order is numeric; gaps are fine. Set ENABLED=false to skip a project.
# Scripts are relative to the project directory. CHECK is optional; UPDATE
# is required only when using sandwich integrations update.
PROJECT_1="$HERMES_PROJECTS_DIR/context-mode"
PROJECT_1_ENABLED=false
PROJECT_1_INTEGRATE=integrate.sh
PROJECT_1_CHECK=audit.sh
PROJECT_1_UPDATE=update.sh

PROJECT_2="$HERMES_PROJECTS_DIR/persephone"
PROJECT_2_ENABLED=false
PROJECT_2_INTEGRATE=scripts/integrate.sh
PROJECT_2_CHECK=scripts/doctor.sh
PROJECT_2_UPDATE=scripts/update.sh

# Optional readable name (otherwise the directory name is used).
# PROJECT_1_NAME=context-mode
# Optional Bash argument arrays; passed verbatim, never evaluated as commands.
# Use only options actually supported by that project's own entrypoint.
# PROJECT_1_ARGS=(--target hermes)
# Per-action arrays override the common array, including an empty array.
# PROJECT_1_INTEGRATE_ARGS=(--target omp)
# PROJECT_1_CHECK_ARGS=(--target omp)
# PROJECT_1_UPDATE_ARGS=()
# Harness choices (OMP, DSH, Hermes) and harness directories stay owned by
# each integration. Leave ARGS unset to preserve its current defaults.
