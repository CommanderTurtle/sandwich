+def _capture_carried_commits(git_cmd, cwd, remote_branch: str) -> list[str]:
+    """Return real local commits carried above the last fetched upstream tip."""
+    try:
+        result = subprocess.run(
+            git_cmd + ["rev-list", "--reverse", f"{remote_branch}..HEAD"],
+            cwd=cwd,
+            capture_output=True,
+            text=True,
+            encoding="utf-8",
+            errors="replace",
+        )
+    except OSError:
+        return []
+    if result.returncode != 0:
+        return []
+
+    carried: list[str] = []
+    for candidate in result.stdout.splitlines():
+        commit = candidate.strip()
+        if not re.fullmatch(r"[0-9a-fA-F]{40,64}", commit):
+            continue
+        parent_result = subprocess.run(
+            git_cmd + ["rev-list", "--parents", "-n", "1", commit],
+            cwd=cwd,
+            capture_output=True,
+            text=True,
+            encoding="utf-8",
+            errors="replace",
+        )
+        # A shallow boundary appears as a parentless commit. It is not a local
+        # compatibility patch and must never be replayed.
+        if parent_result.returncode == 0 and len(parent_result.stdout.split()) > 1:
+            carried.append(commit)
+    return carried
+
+
+def _restore_carried_commits(
+    git_cmd, cwd, commits: list[str], safety_ref: str
+) -> tuple[bool, str | None]:
+    """Replay carried commits and retain the safety ref on a real conflict."""
+    for commit in commits:
+        result = subprocess.run(
+            git_cmd + ["cherry-pick", commit],
+            cwd=cwd,
+            capture_output=True,
+            text=True,
+            encoding="utf-8",
+            errors="replace",
+        )
+        if result.returncode == 0:
+            continue
+        unmerged = subprocess.run(
+            git_cmd + ["diff", "--name-only", "--diff-filter=U"],
+            cwd=cwd,
+            capture_output=True,
+            text=True,
+            encoding="utf-8",
+            errors="replace",
+        )
+        if not unmerged.stdout.strip():
+            skipped = subprocess.run(
+                git_cmd + ["cherry-pick", "--skip"],
+                cwd=cwd,
+                capture_output=True,
+                text=True,
+                encoding="utf-8",
+                errors="replace",
+            )
+            if skipped.returncode == 0:
+                continue
+        subprocess.run(
+            git_cmd + ["cherry-pick", "--abort"],
+            cwd=cwd,
+            capture_output=True,
+            text=True,
+            encoding="utf-8",
+            errors="replace",
+        )
+        detail = result.stderr.strip().splitlines()
+        return False, detail[0] if detail else f"could not apply {commit[:10]}"
+
+    subprocess.run(
+        git_cmd + ["update-ref", "-d", safety_ref],
+        cwd=cwd,
+        capture_output=True,
+        text=True,
+        encoding="utf-8",
+        errors="replace",
+    )
+    return True, None
