+
+if [ "$TOTAL_ERRORS" -gt 0 ]; then
+  echo ""
+  echo "=== Errors by Code ==="
+  grep -oP 'error TS\d+' /tmp/tsc-output.txt | sort | uniq -c | sort -rn | head -20
