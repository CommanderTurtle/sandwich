+  grep 'error TS' /tmp/tsc-output.txt | cut -d'(' -f1 | sort | uniq -c | sort -rn | head -20
+
+  echo ""
+  echo "=== First 30 Errors ==="
+  grep 'error TS' /tmp/tsc-output.txt | head -30
+fi
