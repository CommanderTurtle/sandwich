+def _normalize_systemd_unit_for_comparison(text: str) -> str:
+    """Normalize harmless systemd-unit drift before staleness checks.
+
+    Service PATH generation combines shell and managed-runtime entries. Some
+    launch paths can contribute the same directory twice; systemd treats that
+    exactly like one entry, so de-duplicate it while preserving order.
+    """
+    normalized = _normalize_service_definition(
+        _strip_optional_systemd_directives(text)
+    )
+    prefix = 'Environment="PATH='
+    lines = []
+    for line in normalized.splitlines():
+        if line.startswith(prefix) and line.endswith('"'):
+            entries = line[len(prefix) : -1].split(":")
+            deduplicated = []
+            seen = set()
+            for entry in entries:
+                key = entry.rstrip("/") or "/"
+                if key not in seen:
+                    seen.add(key)
+                    deduplicated.append(key)
+            line = f'{prefix}{":".join(deduplicated)}"'
+        lines.append(line)
+    return "\n".join(lines)
+
