{
  "schema_version": "sandwich.component.v1",
  "id": "sandwich",
  "version": "0.5.0",
  "runtime": "bun",
  "install_scope": "user",
  "repository": "https://github.com/CommanderTurtle/sandwich.git",
  "entrypoints": {
    "sandwich": "bin/sandwich",
    "node": "bin/node",
    "npm": "bin/npm",
    "npx": "bin/npx",
    "pnpm": "bin/pnpm",
    "yarn": "bin/yarn",
    "corepack": "bin/corepack"
  },
  "operations": {
    "doctor": {
      "argv": ["bin/sandwich", "doctor"],
      "mutating": false,
      "human_confirmation": false
    },
    "audit": {
      "argv": ["scripts/purge-foreign-runtimes.sh", "--check"],
      "mutating": false,
      "human_confirmation": false
    },
    "install_preview": {
      "argv": ["scripts/install-user.sh", "--check"],
      "mutating": false,
      "human_confirmation": false
    },
    "install": {
      "argv": ["scripts/install-user.sh", "--apply"],
      "mutating": true,
      "human_confirmation": true
    },
    "hermes_check": {
      "argv": ["bin/sandwich", "hermes", "check"],
      "mutating": false,
      "human_confirmation": false
    },
    "hermes_update": {
      "argv": ["bin/sandwich", "hermes", "update", "--backup", "--yes"],
      "mutating": true,
      "human_confirmation": true,
      "maintenance_window": true
    }
  },
  "integrations": {
    "hermes": {
      "mode": "external-command-compatibility",
      "command": ["bin/sandwich", "hermes", "update"],
      "source_mutation": false
    }
  }
}
