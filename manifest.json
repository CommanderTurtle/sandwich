{
  "schema_version": "sandwich.component.v1",
  "id": "sandwich",
  "version": "0.9.0",
  "runtime": "bun",
  "install_scope": "user",
  "repository": "https://github.com/CommanderTurtle/sandwich.git",
  "entrypoints": {
    "sandwich": "bin/sandwich",
    "node": "bin/node",
    "npm": "bin/npm",
    "npx": "bin/npx",
    "pnpm": "bin/pnpm",
    "yarn": "bin/yarn",
    "corepack": "bin/corepack"
  },
  "operations": {
    "doctor": {
      "argv": ["bin/sandwich", "doctor"],
      "mutating": false,
      "human_confirmation": false
    },
    "audit": {
      "argv": ["scripts/purge-foreign-runtimes.sh", "--check"],
      "mutating": false,
      "human_confirmation": false
    },
    "check_expr": {
      "argv": ["bin/sandwich", "checkExpr"],
      "mutating": true,
      "human_confirmation": true
    },
    "check_fence_preview": {
      "argv": ["bin/sandwich", "checkFence", "--dryrun"],
      "mutating": false,
      "human_confirmation": false
    },
    "check_fence_apply": {
      "argv": ["bin/sandwich", "checkFence", "--apply=projects"],
      "mutating": true,
      "human_confirmation": true
    },
    "check_zoo_preview": {
      "argv": ["bin/sandwich", "checkZoo", "--dryrun"],
      "mutating": false,
      "human_confirmation": false
    },
    "check_zoo_apply": {
      "argv": ["bin/sandwich", "checkZoo", "--apply=projects"],
      "mutating": true,
      "human_confirmation": true
    },
    "install_preview": {
      "argv": ["scripts/install-user.sh", "--check"],
      "mutating": false,
      "human_confirmation": false
    },
    "install": {
      "argv": ["scripts/install-user.sh", "--apply"],
      "mutating": true,
      "human_confirmation": true
    },
    "hermes_check": {
      "argv": ["bin/sandwich", "hermes", "check"],
      "mutating": false,
      "human_confirmation": false
    },
    "hermes_update": {
      "argv": ["bin/sandwich", "hermes", "update", "--backup", "--yes"],
      "mutating": true,
      "human_confirmation": true,
      "maintenance_window": true
    },
    "integrations_check": {
      "argv": ["scripts/manage-integrations.sh", "check", "--strict"],
      "mutating": false,
      "human_confirmation": false
    },
    "integrations_reconcile": {
      "argv": ["scripts/manage-integrations.sh", "reconcile", "--strict"],
      "mutating": true,
      "human_confirmation": true,
      "maintenance_window": true
    },
    "integrations_update": {
      "argv": ["scripts/manage-integrations.sh", "update", "--strict"],
      "mutating": true,
      "human_confirmation": true,
      "maintenance_window": true
    },
    "repository_audit": {
      "argv": ["scripts/manage-repository.sh", "audit"],
      "mutating": false,
      "human_confirmation": false
    },
    "repository_update": {
      "argv": ["scripts/manage-repository.sh", "update"],
      "mutating": true,
      "human_confirmation": true,
      "maintenance_window": true
    }
  },
  "integrations": {
    "node_type_stripping": {
      "mode": "position-preserving",
      "implementation": "amaro@1.1.11",
      "source_mutation": false
    },
    "hermes": {
      "mode": "external-command-compatibility",
      "command": ["bin/sandwich", "hermes", "update"],
      "source_mutation": false
    },
    "integration_owners": {
      "mode": "repository-owned-scripts",
      "command": ["bin/sandwich", "integrations", "reconcile"],
      "source_mutation": false
    }
  }
}
